<?xml version="1.0" encoding="utf-8"?>
<!-- Kieu dung chung cho ca app (khop ban thiet ke): 1 kieu the, 3 kieu nut, 1 kieu o nhap, 5 co chu. -->
<resources>

    <!-- The: nen surface, vien 1dp, bo 16, khong do bong -->
    <style name="Widget.AutoMacro.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- Nut PHU (mac dinh cua app): nen raised, vien line, chu sang. Cao toi thieu 44dp -->
    <style name="Widget.AutoMacro.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/raised</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Nut CHINH (vang sao): hanh dong quan trong nhat man hinh, vd Luu cai dat. Toi da 1 nut / man hinh -->
    <style name="Widget.AutoMacro.Button.Tonal" parent="Widget.AutoMacro.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Nut phu dang vien (giu ten cu): giong nut phu, nen trong -->
    <style name="Widget.AutoMacro.Button.Outlined" parent="Widget.AutoMacro.Button">
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <!-- Nut NGUY HIEM / DUNG -->
    <style name="Widget.AutoMacro.Button.Danger" parent="Widget.AutoMacro.Button">
        <item name="backgroundTint">@color/bad_tint</item>
        <item name="strokeColor">@color/bad_line</item>
        <item name="android:textColor">@color/bad</item>
    </style>

    <!-- O nhap: khung bo 12, nen raised, vien line, doi sang tim khi chon -->
    <style name="Widget.AutoMacro.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxBackgroundColor">@color/raised</item>
        <item name="boxStrokeColor">@color/selected</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>

    <!-- 5 CO CHU DUY NHAT: so lon 26, tieu de man hinh 20, ten the 14, noi dung 13, chu thich 11.5 -->
    <style name="TextAppearance.StarHub.Number" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.StarHub.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.StarHub.CardTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.StarHub.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="TextAppearance.StarHub.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Giu ten cu cho cac man hinh chua chuyen -->
    <style name="TextAppearance.AutoMacro.SectionTitle" parent="TextAppearance.StarHub.Title" />

</resources>
